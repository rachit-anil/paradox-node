aws_region   = "ap-south-1"
project_name = "paradox"
environment  = "production"
domain_name  = "projectparadox.in"

# GitHub repo used for OIDC trust (Actions assume role)
github_org  = "YOUR_GITHUB_ORG_OR_USER"
github_repo = "paradox-node"

# Optional: set to your Route53 hosted zone ID to auto-validate ACM + create alias
# route53_zone_id = "Zxxxxxxxxxxxxx"

instance_type     = "t3.small"
db_instance_class = "db.t4g.micro"
db_name           = "spring"
db_username       = "paradox_app"

# Provide secrets via environment (do not commit real values):
#   export TF_VAR_jwt_secret_key='...'
#   export TF_VAR_google_oauth_client_id='...'
#   export TF_VAR_google_oauth_client_secret='...'
jwt_secret_key             = "CHANGE_ME_use_TF_VAR_instead"
google_oauth_client_id     = ""
google_oauth_client_secret = ""
